<Project>
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)'==''">$(MSBuildThisFileDirectory)</SolutionDir>
    <ThirdPartyDir>$(SolutionDir)third_party\</ThirdPartyDir>
    <AssimpDir>$(ThirdPartyDir)assimp\</AssimpDir>
    <DirectXTKDir>$(ThirdPartyDir)DirectXTK\</DirectXTKDir>
    <ImGuiDir>$(ThirdPartyDir)imgui\</ImGuiDir>
    <ImGuiNodeEditorDir>$(ThirdPartyDir)imgui-node-editor\</ImGuiNodeEditorDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>
        $(DirectXTKDir)include;
        $(DirectXTKDir)include\directxtk;
        $(DirectXTKDir)src;
        $(ImGuiDir);
        $(ImGuiDir)backends;
        $(ImGuiDir)misc\cpp;
        $(ImGuiNodeEditorDir);
        $(AssimpDir)include;
        $(ThirdPartyDir)stb;
        $(ThirdPartyDir)FMOD\inc;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>
        $(AssimpDir)lib\msvc;
        $(ThirdPartyDir)FMOD\64x;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        assimp-vc143-mt.lib;
        d3d11.lib;
        dxgi.lib;
        d3dcompiler.lib;
        dxguid.lib;
        windowscodecs.lib;
        xinput.lib;
        wbemuuid.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
