<Project>
  <ItemGroup>
    <FxCompile Update="*PS*.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*PixelShader*.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*VS*.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*VertexShader*.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*SkyBoxPS.hlsl">
      <EntryPointName>PS</EntryPointName>
    </FxCompile>
    <FxCompile Update="*SkyBoxVS.hlsl">
      <EntryPointName>VS</EntryPointName>
    </FxCompile>
  </ItemGroup>

  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <!-- 공통 bin 폴더 정의 -->
  <PropertyGroup>
    <CommonBinDir>$(SolutionDir)bin\</CommonBinDir>
  </PropertyGroup>

  <!-- bin 및 shaders 폴더 생성 -->
  <Target Name="EnsureCommonBin"
          BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(CommonBinDir)" />
  </Target>

  <!-- 빌드 후 결과물 복사 -->
  <Target Name="CopyOutputsToCommonBin"
          AfterTargets="Build">
    <Message Importance="high"
             Text=">>> [Copy] 실행됨: $(TargetPath) -> $(CommonBinDir)" />

    <!-- exe/dll -->
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true" />

    <!-- pdb (있는 경우만) -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

  <!-- project-local runtime support files -->
  <Target Name="CopyProjectFilesToCommonBin"
          AfterTargets="Build"
          Condition="'@(CopyFileToFolders)'!=''">
    <Copy SourceFiles="@(CopyFileToFolders->'%(FullPath)')"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- repo-local runtime DLLs -->
  <Target Name="CopyThirdPartyRuntimeDlls"
          AfterTargets="Build"
          Condition="'$(ConfigurationType)'!='StaticLibrary'">
    <ItemGroup>
      <RuntimeDll Include="$(SolutionDir)third_party\assimp\bin\msvc\assimp-vc143-mt.dll"
                  Condition="Exists('$(SolutionDir)third_party\assimp\bin\msvc\assimp-vc143-mt.dll')" />
      <RuntimeDll Include="$(SolutionDir)third_party\FMOD\64x\fmod.dll"
                  Condition="Exists('$(SolutionDir)third_party\FMOD\64x\fmod.dll')" />
      <RuntimeDll Include="$(SolutionDir)third_party\FMOD\64x\fmodL.dll"
                  Condition="Exists('$(SolutionDir)third_party\FMOD\64x\fmodL.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(RuntimeDll)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Retries="10"
          RetryDelayMilliseconds="250"
          Condition="'@(RuntimeDll)'!=''" />

    <Copy SourceFiles="@(RuntimeDll)"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true"
          Retries="10"
          RetryDelayMilliseconds="250"
          Condition="'@(RuntimeDll)'!=''" />
  </Target>
</Project>
