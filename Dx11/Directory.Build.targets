<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AliceTutorialBrandingProjects>;01_RenderingQuadangle;02_RenderingCube;03_RenderingMeshAndSceneGraph;04_RenderingMeshWithTexture;05_Mesh;06_pmx;07_pmxTexture;08_ImguiSystemInfo;09_Lighting;10_StaticCube_SkyBox;11_Live2D;12_Lighting_BlinnPhong;13_LineRenderer_AxisDebug;14_Lighting_Phong;15_pmxWithPhong;16_NormalMapping;17_fbx_pmx_obj_WithPhong;18_fbx_Animation;19_MultiModels;20_Depth_And_Alpha_Issue;21_MultiModels_With_Animations;22_VMD;23_Rigid_Animation;24_Skinned_With_Bone_Structure;25_ToonShading_Outline;26_ShadowMap_PCF;27_DebugDraw;28_Scene_Shared3DModel_Animation;29_MousePicking;30_PBR_BRDF;31_IBL;32_Sound_FMOD;33_Sound_Animation_Camera_Motion;34_ToneMapping;35_DeferredRendering;36_AdvancedAnim_Sound_Click;37_Blueprint;38_StylizedToonPBR;</AliceTutorialBrandingProjects>
    <AliceTutorialBrandingEnabled Condition="'$(ConfigurationType)' == 'Application'">$([System.String]::Copy('$(AliceTutorialBrandingProjects)').Contains(';$(MSBuildProjectName);'))</AliceTutorialBrandingEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(AliceTutorialBrandingEnabled)' == 'True'">
    <ResourceCompile Include="$(MSBuildThisFileDirectory)Resource\Icon\AppIcon.rc" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(AliceTutorialBrandingEnabled)' == 'True'">
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Resource\Icon;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <FxCompile Update="*PS*.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*PixelShader*.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*VS*.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*VertexShader*.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
    <FxCompile Update="*SkyBoxPS.hlsl">
      <EntryPointName>PS</EntryPointName>
    </FxCompile>
    <FxCompile Update="*SkyBoxVS.hlsl">
      <EntryPointName>VS</EntryPointName>
    </FxCompile>
  </ItemGroup>

  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <!-- 공통 bin 폴더 정의 -->
  <PropertyGroup>
    <CommonBinDir>$(SolutionDir)bin\</CommonBinDir>
  </PropertyGroup>

  <!-- bin 및 shaders 폴더 생성 -->
  <Target Name="EnsureCommonBin"
          BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(CommonBinDir)" />
  </Target>

  <!-- 빌드 후 결과물 복사 -->
  <Target Name="CopyOutputsToCommonBin"
          AfterTargets="Build">
    <Message Importance="high"
             Text=">>> [Copy] 실행됨: $(TargetPath) -> $(CommonBinDir)" />

    <!-- exe/dll -->
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true" />

    <!-- pdb (있는 경우만) -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

  <!-- project-local runtime support files -->
  <Target Name="CopyProjectFilesToCommonBin"
          AfterTargets="Build"
          Condition="'@(CopyFileToFolders)'!=''">
    <Copy SourceFiles="@(CopyFileToFolders->'%(FullPath)')"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- compiled shader outputs -->
  <Target Name="CopyCompiledShadersToCommonBin"
          AfterTargets="Build">
    <ItemGroup Condition="'@(FxCompile)'!=''">
      <CompiledShader Include="@(FxCompile->'$(TargetDir)%(Filename).cso')" />
      <CompiledShader Remove="@(CompiledShader)"
                      Condition="!Exists('%(CompiledShader.Identity)')" />
    </ItemGroup>

    <Copy SourceFiles="@(CompiledShader)"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true"
          Condition="'@(CompiledShader)'!=''" />
  </Target>

  <!-- runtime shader sources/includes used by projects that compile HLSL at startup -->
  <Target Name="CopyRuntimeShaderFilesToCommonBin"
          AfterTargets="Build">
    <ItemGroup>
      <RuntimeShaderSource Include="@(FxCompile)" />
      <RuntimeShaderInclude Include="@(None)"
                            Condition="'%(Extension)'=='.fxh' Or '%(Extension)'=='.hlsli'" />
    </ItemGroup>

    <Copy SourceFiles="@(RuntimeShaderSource->'%(FullPath)');@(RuntimeShaderInclude->'%(FullPath)')"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true"
          Condition="'@(RuntimeShaderSource)'!='' Or '@(RuntimeShaderInclude)'!=''" />
  </Target>

  <!-- repo-local runtime DLLs -->
  <Target Name="CopyThirdPartyRuntimeDlls"
          AfterTargets="Build"
          Condition="'$(ConfigurationType)'!='StaticLibrary'">
    <ItemGroup>
      <RuntimeDll Include="$(SolutionDir)third_party\assimp\bin\msvc\assimp-vc143-mt.dll"
                  Condition="Exists('$(SolutionDir)third_party\assimp\bin\msvc\assimp-vc143-mt.dll')" />
      <RuntimeDll Include="$(SolutionDir)third_party\FMOD\64x\fmod.dll"
                  Condition="Exists('$(SolutionDir)third_party\FMOD\64x\fmod.dll')" />
      <RuntimeDll Include="$(SolutionDir)third_party\FMOD\64x\fmodL.dll"
                  Condition="Exists('$(SolutionDir)third_party\FMOD\64x\fmodL.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(RuntimeDll)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Retries="10"
          RetryDelayMilliseconds="250"
          Condition="'@(RuntimeDll)'!=''" />

    <Copy SourceFiles="@(RuntimeDll)"
          DestinationFolder="$(CommonBinDir)"
          SkipUnchangedFiles="true"
          Retries="10"
          RetryDelayMilliseconds="250"
          Condition="'@(RuntimeDll)'!=''" />
  </Target>
</Project>
